{
  "name": "programa-cajas",
  "version": "3.1.0",
  "description": "Sistema POS y Control de Cajas en AWS con Next.js y PostgreSQL",
  "scripts": {
    "test": "npm run simular",
    "test:postgres": "node --env-file-if-exists=.env.local scripts/test-postgres.js",
    "test:e2e": "node --env-file-if-exists=.env.local tests/postgres-fixture.js",
    "test:all": "npm run test:postgres && npm run simular && npm run test:e2e",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "migrate:control": "node database/migraciones-control.js",
    "migrate:tenant": "node database/migraciones-tenant.js",
    "provision:tenant": "node database/provisionar-tenant.js",
    "seed": "node --env-file-if-exists=.env.local scripts/seed_cafeteria.js",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/seed_demo.js",
    "simular": "node --env-file-if-exists=.env.local tests/simulador_integral.js",
    "backup": "node --env-file-if-exists=.env.local scripts/backup-postgres.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@base-ui/react": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.17",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19"
  }
}
