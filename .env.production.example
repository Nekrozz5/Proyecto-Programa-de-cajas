# ==========================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN
# Renombra o copia este archivo a .env en tu servidor
# ==========================================

NODE_ENV=production
PORT=3000

# Ruta absoluta o relativa al archivo de base de datos SQLite
# Si usas Docker con volumen montado, déjalo en /app/data/caja.db
DATABASE_PATH=./data/caja.db

# Clave secreta para firmar tokens JWT (Mínimo 32 caracteres aleatorios seguros)
# Puedes generar uno en Linux con: openssl rand -hex 32
SESSION_SECRET=cambia_esta_cadena_por_un_secreto_aleatorio_muy_largo_y_seguro_123456

# Contraseña maestra del perfil developer para mantenimiento y diagnóstico técnico
DEVELOPER_PASSWORD=CambiaEstaClaveDeveloperEnProduccion!

# Configuración opcional para respaldos en AWS S3
# S3_BUCKET=mi-bucket-de-respaldos-cajas
# MAX_BACKUPS_LOCAL=30
