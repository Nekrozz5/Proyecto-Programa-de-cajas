# ==========================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN
# Renombra o copia este archivo a .env en tu servidor
# ==========================================
# IMPORTANTE: los valores "REEMPLAZAR_..." son marcadores. Con NODE_ENV=production
# el servidor se niega a arrancar si alguno de los secretos conserva ese valor.

NODE_ENV=production
# Puerto interno donde escucha la aplicación en el servidor AWS (detrás de Nginx / AWS ALB / CloudFront)
PORT=3000

# Plataforma 100% cloud: el tenant se resuelve por subdominio del negocio.
TENANCY_MODE=AWS_MULTI_TENANT
TENANT_HOST_SUFFIX=miapp.com
AWS_REGION=us-east-2
# Usa Secrets Manager solo cuando el entorno ya tenga secretos y permisos IAM.
TENANT_SECRETS_PROVIDER=aws
# Hosts permitidos para invocar Server Actions detrás del proxy AWS.
# Usar nombres de host, sin https://; el comodín cubre un nivel de subdominio.
ALLOWED_ORIGINS=miapp.com,*.miapp.com

# PostgreSQL es el único motor de persistencia. La base de control registra los
# tenants y cada negocio tiene su propia base operativa.
# En AWS, el resolver usa database_secret_ref y Secrets Manager. Este mapa queda
# únicamente como respaldo explícito para desarrollo o migraciones controladas.
CONTROL_DATABASE_URL=postgresql://usuario:password@host:5432/control_plane
# TENANT_DATABASE_URLS_JSON={"tenant-id":"postgresql://usuario:password@host:5432/negocio_001"}
PG_SSL=true
# Ruta al certificado CA de RDS. Con esta variable se valida el certificado del servidor.
# PG_SSL_CA=/etc/ssl/certs/global-bundle.pem
PG_POOL_MAX=10

# Clave secreta para firmar tokens JWT (mínimo 32 caracteres aleatorios).
# Genera una en Linux con: openssl rand -hex 32
# En producción NO se genera automáticamente: si falta, es corta o es el marcador, el arranque falla.
SESSION_SECRET=REEMPLAZAR_con_openssl_rand_hex_32

# Contraseña del perfil técnico developer (mínimo 8 caracteres, distinta del marcador).
# Si se deja vacía o se elimina la línea, la cuenta developer no se crea ni queda habilitada.
DEVELOPER_PASSWORD=REEMPLAZAR_clave_developer

# Confiabilidad de Balanceador / Proxy Inverso (AWS ALB / CloudFront / Nginx)
# En producción detrás de un proxy o balanceador, ponlo en true
# para leer la IP externa real (X-Real-IP / CF-Connecting-IP) sin mezclarla con el cajero local.
TRUST_PROXY=true

# Necesaria cuando se ejecutan varias instancias con Server Actions inline.
# En una sola instancia puede omitirse; en varias debe ser la misma clave en todas.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REEMPLAZAR_clave_estable_base64

# Retención de respaldos PostgreSQL por tenant en la carpeta backups/.
# En AWS esta ubicación local debe sustituirse o sincronizarse con S3.
# Ejecutar npm run backup -- <slug> con pg_dump disponible.
MAX_BACKUPS_LOCAL=30
# BACKUP_DIR=/var/lib/pos-cajas/backups

# ==========================================
# NOTIFICACIONES POR CORREO (REPORTES DE CIERRE Y EXCEL)
# ==========================================
# Proveedor por defecto: Gmail con contraseña de aplicación (o cualquier SMTP como Resend/Brevo/Amazon SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tu_correo_de_envio@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion_google
# Correo(s) del dueño o gerente que recibirá los reportes (separados por coma si son varios):
# EMAIL_DESTINATARIO_CIERRE=dueno@empresa.com,encargado@empresa.com
# Remitente visible opcional:
# EMAIL_REMITENTE="Mi Negocio POS" <tu_correo_de_envio@gmail.com>
